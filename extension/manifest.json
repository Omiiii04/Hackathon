{
  "manifest_version": 3,
  "name": "OSINT Engine",
  "version": "1.0.0",
  "description": "AI-powered multi-source fact-checking platform.",
  "permissions": ["contextMenus", "activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "OSINT Verify"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
