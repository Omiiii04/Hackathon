# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE (Docker PostgreSQL) ──────────────────────────────────────────────
# These vars drive docker-compose AND the Python asyncpg connection.
# To change the DB name: update POSTGRES_DB and DATABASE_URL together.
POSTGRES_DB=osint_verify
POSTGRES_USER=omii
POSTGRES_PASSWORD=omii00
DATABASE_URL=postgresql://omii:omii00@localhost:5432/osint_verify

# ── REDIS ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LOCAL LLM (LM Studio) ─────────────────────────────────────────────────────
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_TIMEOUT=60

# ── CLOUD LLM FALLBACK ────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# ── DATA SOURCES ──────────────────────────────────────────────────────────────
# Wikipedia (mandatory — no key needed, but email required by Wikipedia API ToS)
WIKIPEDIA_EMAIL=omapar0123@gmail.com

# NewsAPI  (free tier: 100 req/day — https://newsapi.org)
NEWS_API_KEY=

# Google Fact Check (free — https://console.cloud.google.com)
GOOGLE_FACTCHECK_API_KEY=

# SERP API (optional — https://serpapi.com)
SERP_API_KEY=

# GDELT (no key needed — free global news)
GDELT_ENABLED=true

# DuckDuckGo (no key needed — HTML scrape)
DDG_ENABLED=true

# Reddit (no key needed — JSON API)
REDDIT_ENABLED=true

# ── ALGORITHM ─────────────────────────────────────────────────────────────────
EVIDENCE_MAX_ARTICLES=5
EVIDENCE_MAX_SENTENCES=5
EARLY_EXIT_TIER1_THRESHOLD=2
EARLY_EXIT_RATIO_HIGH=0.80
EARLY_EXIT_RATIO_LOW=0.20
MUTATION_SIMILARITY_THRESHOLD=0.75
CONFIDENCE_SIGMOID_SCALE=10
CIRCUIT_BREAKER_FAIL_MAX=3
CIRCUIT_BREAKER_RESET_SECONDS=60

# ── HARDENING ─────────────────────────────────────────────────────────────────
HTTP_REQUEST_TIMEOUT_SECONDS=8
GATHER_TIMEOUT_SECONDS=20
FREEZE_CREDIBILITY=false

# ── APP ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-python-secrets
OFFLINE_MODE=false
CACHE_TTL_DAYS=7
