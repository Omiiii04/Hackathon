# Database configuration
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://:@localhost:5432/osint_verify

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# LLM CONFIGURATION
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_TIMEOUT=60

# cloud LLMs (optional — requires API keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# DATA SOURCES
# Wikipedia
WIKIPEDIA_EMAIL=

# NewsAPI  (https://newsapi.org)
NEWS_API_KEY=

# Google Fact Checker (https://console.cloud.google.com)
GOOGLE_FACTCHECK_API_KEY=

# SERP API (https://serpapi.com)
SERP_API_KEY=

# GDELT (free global news)
GDELT_ENABLED=true

# DuckDuckGo (HTML scrape)
DDG_ENABLED=true

# Reddit (JSON API)
REDDIT_ENABLED=true

# ALGORITHM Configuration
EVIDENCE_MAX_ARTICLES=5
EVIDENCE_MAX_SENTENCES=5
EARLY_EXIT_TIER1_THRESHOLD=2
EARLY_EXIT_RATIO_HIGH=0.80
EARLY_EXIT_RATIO_LOW=0.20
MUTATION_SIMILARITY_THRESHOLD=0.75
CONFIDENCE_SIGMOID_SCALE=10
CIRCUIT_BREAKER_FAIL_MAX=3
CIRCUIT_BREAKER_RESET_SECONDS=60

# TIMEOUTS
HTTP_REQUEST_TIMEOUT_SECONDS=8
GATHER_TIMEOUT_SECONDS=20
FREEZE_CREDIBILITY=false

# Other settings
SECRET_KEY=change-me-generate-with-python-secrets
OFFLINE_MODE=false
CACHE_TTL_DAYS=7